{
  "name": "nexus",
  "version": "0.7.2-development",
  "private": true,
  "description": "Local-first multi-agent software-engineering control plane",
  "author": "Youssef Melki",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration --project arena-cases",
    "test:e2e": "electron-vite build && playwright test",
    "smoke:claude": "vitest run -c vitest.smoke.config.ts",
    "smoke:power": "vitest run -c vitest.power-smoke.config.ts",
    "smoke:usage": "vitest run -c vitest.usage-smoke.config.ts",
    "smoke:cache": "vitest run -c vitest.cache-smoke.config.ts",
    "bench:retrieval": "vitest run --project integration tests/integration/context-graph/retrieval-benchmark.test.ts",
    "baseline:tokens": "node scripts/token-baseline.mjs",
    "smoke:providers": "vitest run -c vitest.providers-smoke.config.ts",
    "smoke:dialog": "vitest run -c vitest.dialog-smoke.config.ts",
    "accept:proposal": "node scripts/dynamic-proposal-acceptance.mjs",
    "accept:rotation": "node scripts/session-rotation-acceptance.mjs",
    "accept:arena": "node scripts/arena-acceptance.mjs",
    "accept:workspace": "node scripts/workspace-acceptance.mjs",
    "accept:speculative": "node scripts/strategy-acceptance.mjs speculative",
    "accept:adaptive": "node scripts/strategy-acceptance.mjs adaptive",
    "accept:v07": "node scripts/v07-acceptance.mjs",
    "accept:graph": "vitest run -c vitest.graph-accept.config.ts",
    "accept:compaction": "vitest run -c vitest.compaction.config.ts",
    "accept:campaign": "vitest run -c vitest.campaign.config.ts",
    "accept:director": "vitest run -c vitest.director.config.ts",
    "stress": "vitest run -c vitest.stress.config.ts",
    "supervisor:build": "esbuild scripts/dev-supervisor/development-overnight-supervisor.ts --bundle --platform=node --format=esm --alias:@shared=./src/shared --alias:@main=./src/main --outfile=out/dev-supervisor/development-overnight-supervisor.mjs",
    "package": "electron-vite build && electron-builder --win nsis"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.288",
    "@anthropic-ai/sdk": "^0.131.0",
    "@dagrejs/dagre": "^3.1.1",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@tanstack/react-query": "5.104.1",
    "@xyflow/react": "12.12.0",
    "better-sqlite3": "13.0.3",
    "cmdk": "1.1.1",
    "react": "19.3.0",
    "react-diff-view": "3.3.3",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "4.14.2",
    "rehype-sanitize": "6.0.0",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "5.1.4",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "^3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "7.3.6",
    "vitest": "5.0.3"
  }
}
